    {
      "name": "Get Statistics",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "// Status code validation",
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "// JSON Schema validation",
              "pm.test(\"Response matches JSON schema\", function () {",
              "    const schema = {",
              "        type: 'object',",
              "        required: ['success', 'data'],",
              "        properties: {",
              "            success: { type: 'boolean', enum: [true] },",
              "            data: {",
              "                type: 'object',",
              "                required: ['noun', 'verb', 'adjective', 'adverb'],",
              "                properties: {",
              "                    noun: { type: 'integer', minimum: 0 },",
              "                    verb: { type: 'integer', minimum: 0 },",
              "                    adjective: { type: 'integer', minimum: 0 },",
              "                    adverb: { type: 'integer', minimum: 0 }",
              "                },",
              "                additionalProperties: false",
              "            }",
              "        },",
              "        additionalProperties: false",
              "    };",
              "    pm.response.to.have.jsonSchema(schema);",
              "});",
              "",
              "// Data validation",
              "pm.test(\"All counts are non-negative integers\", function () {",
              "    const jsonData = pm.response.json();",
              "    Object.values(jsonData.data).forEach(count => {",
              "        pm.expect(count).to.be.a('number');",
              "        pm.expect(count).to.be.at.least(0);",
              "        pm.expect(Number.isInteger(count)).to.be.true;",
              "    });",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/stats",
          "host": ["{{baseUrl}}"],
          "path": ["api", "stats"]
        }
      }
    },
    {
      "name": "Generate Sentence - Success",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "// Status code validation",
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "// JSON Schema validation",
              "pm.test(\"Response matches JSON schema\", function () {",
              "    const schema = {",
              "        type: 'object',",
              "        required: ['success', 'data'],",
              "        properties: {",
              "            success: { type: 'boolean', enum: [true] },",
              "            data: {",
              "                type: 'object',",
              "                required: ['sentence'],",
              "                properties: {",
              "                    sentence: { ",
              "                        type: 'string',",
              "                        minLength: 1,",
              "                        pattern: '^[A-Z].*\\\\.$'",
              "                    }",
              "                },",
              "                additionalProperties: false",
              "            }",
              "        },",
              "        additionalProperties: false",
              "    };",
              "    pm.response.to.have.jsonSchema(schema);",
              "});",
              "",
              "// Business logic validation",
              "pm.test(\"Sentence starts with capital letter\", function () {",
              "    const jsonData = pm.response.json();",
              "    pm.expect(jsonData.data.sentence.charAt(0)).to.match(/[A-Z]/);",
              "});",
              "",
              "pm.test(\"Sentence ends with period\", function () {",
              "    const jsonData = pm.response.json();",
              "    const sentence = jsonData.data.sentence;",
              "    pm.expect(sentence.charAt(sentence.length - 1)).to.eql('.');",
              "});",
              "",
              "pm.test(\"Sentence contains at least one word\", function () {",
              "    const jsonData = pm.response.json();",
              "    const words = jsonData.data.sentence.replace('.', '').trim().split(' ');",
              "    pm.expect(words.length).to.be.at.least(1);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"includeNoun\": true,\n  \"includeVerb\": true,\n  \"includeAdjective\": true,\n  \"includeAdverb\": false\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/generate-sentence",
          "host": ["{{baseUrl}}"],
          "path": ["api", "generate-sentence"]
        }
      }
    },
