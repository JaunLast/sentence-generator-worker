{
  "info": {
    "_postman_id": "sentence-generator-api-schema",
    "name": "Sentence Generator API (with JSON Schema Validation)",
    "description": "API tests with comprehensive JSON Schema validation for all endpoints",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Health Check",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "// Status code validation",
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "// Response time validation",
              "pm.test(\"Response time is less than 500ms\", function () {",
              "    pm.expect(pm.response.responseTime).to.be.below(500);",
              "});",
              "",
              "// JSON Schema validation",
              "pm.test(\"Response matches JSON schema\", function () {",
              "    const schema = {",
              "        type: 'object',",
              "        required: ['status', 'timestamp'],",
              "        properties: {",
              "            status: {",
              "                type: 'string',",
              "                enum: ['healthy']",
              "            },",
              "            timestamp: {",
              "                type: 'string',",
              "                format: 'date-time'",
              "            }",
              "        },",
              "        additionalProperties: false",
              "    };",
              "    ",
              "    pm.response.to.have.jsonSchema(schema);",
              "});",
              "",
              "// Content-Type validation",
              "pm.test(\"Content-Type is application/json\", function () {",
              "    pm.response.to.have.header('Content-Type');",
              "    pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/health",
          "host": ["{{baseUrl}}"],
          "path": ["api", "health"]
        }
      }
    },
    {
      "name": "Get All Categories",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "// Status code validation",
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "// Response time validation",
              "pm.test(\"Response time is less than 500ms\", function () {",
              "    pm.expect(pm.response.responseTime).to.be.below(500);",
              "});",
              "",
              "// JSON Schema validation",
              "pm.test(\"Response matches JSON schema\", function () {",
              "    const schema = {",
              "        type: 'object',",
              "        required: ['success', 'data'],",
              "        properties: {",
              "            success: {",
              "                type: 'boolean',",
              "                enum: [true]",
              "            },",
              "            data: {",
              "                type: 'array',",
              "                items: {",
              "                    type: 'object',",
              "                    required: ['id', 'name', 'description', 'created_at'],",
              "                    properties: {",
              "                        id: { type: 'integer', minimum: 1 },",
              "                        name: { ",
              "                            type: 'string',",
              "                            enum: ['noun', 'verb', 'adjective', 'adverb']",
              "                        },",
              "                        description: { type: 'string' },",
              "                        created_at: { type: 'string' }",
              "                    },",
              "                    additionalProperties: false",
              "                }",
              "            }",
              "        },",
              "        additionalProperties: false",
              "    };",
              "    ",
              "    pm.response.to.have.jsonSchema(schema);",
              "});",
              "",
              "// Business logic validation",
              "pm.test(\"Returns exactly 4 categories\", function () {",
              "    const jsonData = pm.response.json();",
              "    pm.expect(jsonData.data).to.have.lengthOf(4);",
              "});",
              "",
              "pm.test(\"Categories have correct names\", function () {",
              "    const jsonData = pm.response.json();",
              "    const names = jsonData.data.map(cat => cat.name);",
              "    pm.expect(names).to.include.members(['noun', 'verb', 'adjective', 'adverb']);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/categories",
          "host": ["{{baseUrl}}"],
          "path": ["api", "categories"]
        }
      }
    },
    {
      "name": "Get All Words",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "// Status code validation",
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "// JSON Schema validation",
              "pm.test(\"Response matches JSON schema\", function () {",
              "    const schema = {",
              "        type: 'object',",
              "        required: ['success', 'data'],",
              "        properties: {",
              "            success: {",
              "                type: 'boolean',",
              "                enum: [true]",
              "            },",
              "            data: {",
              "                type: 'array',",
              "                items: {",
              "                    type: 'object',",
              "                    required: ['id', 'word', 'category_id', 'created_at'],",
              "                    properties: {",
              "                        id: { type: 'integer', minimum: 1 },",
              "                        word: { type: 'string', minLength: 1 },",
              "                        category_id: { ",
              "                            type: 'integer',",
              "                            minimum: 1,",
              "                            maximum: 4",
              "                        },",
              "                        created_at: { type: 'string' }",
              "                    },",
              "                    additionalProperties: false",
              "                }",
              "            }",
              "        },",
              "        additionalProperties: false",
              "    };",
              "    ",
              "    pm.response.to.have.jsonSchema(schema);",
              "});",
              "",
              "// Data validation",
              "pm.test(\"All words have valid category_id\", function () {",
              "    const jsonData = pm.response.json();",
              "    jsonData.data.forEach(word => {",
              "        pm.expect(word.category_id).to.be.within(1, 4);",
              "    });",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/words",
          "host": ["{{baseUrl}}"],
          "path": ["api", "words"]
        }
      }
    },
    {
      "name": "Get Words by Category (Nouns)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "// Status code validation",
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "// JSON Schema validation",
              "pm.test(\"Response matches JSON schema\", function () {",
              "    const schema = {",
              "        type: 'object',",
              "        required: ['success', 'data'],",
              "        properties: {",
              "            success: { type: 'boolean', enum: [true] },",
              "            data: {",
              "                type: 'array',",
              "                items: {",
              "                    type: 'object',",
              "                    required: ['id', 'word', 'category_id', 'created_at'],",
              "                    properties: {",
              "                        id: { type: 'integer' },",
              "                        word: { type: 'string' },",
              "                        category_id: { type: 'integer' },",
              "                        created_at: { type: 'string' }",
              "                    }",
              "                }",
              "            }",
              "        }",
              "    };",
              "    pm.response.to.have.jsonSchema(schema);",
              "});",
              "",
              "// Business logic validation",
              "pm.test(\"All words belong to category 1 (noun)\", function () {",
              "    const jsonData = pm.response.json();",
              "    jsonData.data.forEach(word => {",
              "        pm.expect(word.category_id).to.eql(1);",
              "    });",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/words?category_id=1",
          "host": ["{{baseUrl}}"],
          "path": ["api", "words"],
          "query": [
            {
              "key": "category_id",
              "value": "1"
            }
          ]
        }
      }
