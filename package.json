{
  "name": "sentence-generator-worker",
  "version": "1.0.0",
  "description": "Cloudflare Worker backend for Sentence Generator",
  "main": "src/index.ts",
  "scripts": {
    "start": "npm run db:migrate:local && npm run db:seed:local && npm run dev",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "db:migrate": "wrangler d1 migrations apply sentence-generator-db",
    "db:migrate:local": "wrangler d1 migrations apply sentence-generator-db --local",
    "db:seed": "wrangler d1 execute sentence-generator-db --file=./migrations/seed.sql",
    "db:seed:local": "wrangler d1 execute sentence-generator-db --local --file=./migrations/seed.sql",
    "db:setup": "npm run db:migrate:local && npm run db:seed:local"
  },
  "keywords": [
    "cloudflare",
    "workers",
    "d1",
    "typescript"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20231218.0",
    "@types/node": "^20.10.0",
    "@vitest/coverage-v8": "^1.6.1",
    "typescript": "^5.3.3",
    "vitest": "^1.0.4",
    "wrangler": "^3.19.0"
  }
}
